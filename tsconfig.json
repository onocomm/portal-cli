{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "rootDir": "src", "outDir": "dist",
    "declaration": true, "sourceMap": false, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
